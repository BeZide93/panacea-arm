# Copy to config.env. Use paths WITHOUT a trailing slash.
# Run inside the same Linux/DroidDeck environment as Steam.
KH_APPID=2552430
KH_STEAM_ROOT="$HOME/.local/share/Steam"
KH_COMPATDATA="$KH_STEAM_ROOT/steamapps/compatdata/$KH_APPID"
KH_PROTON_ROOT="$HOME/.local/share/droiddeck-esync/dist/valve-experimental-11.0-20261001-arm64-1790819359-76e24eb8146d-r1~015ab1a0"
KH_GAME_DIR="$HOME/Games/Windows/steamapps/common/KINGDOM HEARTS -HD 1.5+2.5 ReMIX-"
KH_BACKUP_ROOT="$HOME/panacea-prefix-backups"
# Optional: existing original OpenKH batch file, not a download from a third-party site.
KH_REGISTRY_BAT=""
