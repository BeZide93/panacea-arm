[Desktop Entry]
Type=Application
Name=Panacea DroidDeck Setup
Comment=Panacea and OpenKH setup wizard
Exec=python3 -c "import os,sys; from pathlib import Path; from urllib.parse import urlparse,unquote; p=sys.argv[1]; p=unquote(urlparse(p).path) if p.startswith('file:') else p; os.execv('/bin/bash',['bash',str(Path(p).resolve().parent/'start-native.sh')])" %k
Icon=system-software-install
Terminal=false
Categories=Utility;
StartupNotify=false
